// Kolos Example Program

fn factorial(n) {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}

fn fibonacci(n) {
    if n <= 1 {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

// Demo calls
print "=== Kalkulacje Kolos ===";

let fact5_str = "Silnia 5";
print fact5_str;
let res_fact = factorial(5);
print res_fact;

let fib7_str = "Fibonacci 7";
print fib7_str;
let res_fib = fibonacci(7);
print res_fib;

// Pętla while
let sum = 0;
let i = 1;
while i <= 10 {
    sum = sum + i;
    i = i + 1;
}

print "Suma 1..10";
print sum;
